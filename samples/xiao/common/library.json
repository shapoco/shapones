{
    "name": "shapones_xiao_core",
    "build": {
        "includeDir": "include",
        "srcDir": "src",
        "srcFilter": [
            "+<*>"
        ],
        "unflags": [
            "-Os",
            "-fno-jump-tables",
            "-fno-tree-switch-conversion"
        ],
        "flags": [
            "-std=gnu++17",
            "-O2",
            "-fjump-tables",
            "-ftree-switch-conversion",
            "-Iinclude",
            "-Isrc/fatfs"
        ]
    },
    "export": {
        "include": [
            "include"
        ]
    },
    "platforms": "*",
    "dependencies": [
        "shapones_core",
        "shapones_fatfs"
    ]
}