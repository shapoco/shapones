{
	"name": "shapones_core",
	"version": "0.0.1",
	"build": {
		"includeDir": "include",
		"srcDir": "src",
		"srcFilter": [
			"+<*>"
		],
        "unflags": [
            "-Os",
            "-fno-jump-tables",
            "-fno-tree-switch-conversion"
        ],
		"flags": [
			"-std=gnu++17",
			"-O2",
            "-fjump-tables",
            "-ftree-switch-conversion",
			"-Iinclude"
		]
	},
	"export": {
		"include": "include"
	},
	"platforms": "*"
}
